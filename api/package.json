{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "build": "prisma generate && tsc",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma generate && prisma db seed",
    "start": "node dist/server.js",
    "auth:create-admin": "prisma generate && node --import tsx prisma/create-admin.ts",
    "billing:run": "prisma generate && node --import tsx src/jobs/run-billing.ts",
    "reminders:run": "prisma generate && node --import tsx src/jobs/run-reminders.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.0.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "node-cron": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "prisma": "^7.10.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
